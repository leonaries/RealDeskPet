{
  "name": "real-desk-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p electron/tsconfig.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite --host 127.0.0.1",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7",
    "typescript": "~5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "electron": "^39.2.7",
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3",
    "lucide-react": "^0.561.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
